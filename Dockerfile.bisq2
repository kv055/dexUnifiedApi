# syntax=docker/dockerfile:1

FROM eclipse-temurin:21-jdk-jammy AS bisq2-builder

ARG BISQ2_VERSION=2.1.15
# Pinned source commit for v${BISQ2_VERSION} (the upstream tag at pin time).
# Upstream tags are mutable: cloning the floating tag reuses a stale cached
# layer while the tag content moves on, so the build must fetch this exact
# commit (changing it also busts the clone layer cache). Keep BISQ2_VERSION
# and BISQ2_COMMIT in sync when bumping.
ARG BISQ2_COMMIT=cfe8ab251f2b6579f29e9955036afc33ba36861e
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN git init -q /src/bisq2 && \
    git -C /src/bisq2 remote add origin https://github.com/bisq-network/bisq2.git && \
    for attempt in 1 2 3 4 5; do \
      git -C /src/bisq2 fetch --depth 1 origin "${BISQ2_COMMIT}" && break; \
      [ "$attempt" = 5 ] && exit 1; sleep 15; \
    done && \
    git -C /src/bisq2 checkout -q --detach FETCH_HEAD && \
    git -C /src/bisq2 submodule update --init --recursive --depth 1

WORKDIR /src/bisq2

# Cache mount keeps the gradle distribution, provisioned JDK toolchain and
# dependencies across builds, so a version bump does not re-download them all.
# Network hardening. Upstream's wrapper gives up on the distribution download
# after 10s without data (networkTimeout=10000): on the CI runner's link that
# killed both bisq builds on 2026-10-18 ("gradle-*-bin.zip failed: timeout").
# Raise that limit, fetch the distribution in its own retried step (cheap, and
# a retry never re-runs a compile), and give dependency downloads longer
# timeouts plus more of Gradle's built-in retries.
RUN --mount=type=cache,target=/root/.gradle \
    sed -i '/^networkTimeout=/d' gradle/wrapper/gradle-wrapper.properties && \
    echo 'networkTimeout=120000' >> gradle/wrapper/gradle-wrapper.properties && \
    for attempt in 1 2 3 4 5; do \
      ./gradlew --no-daemon --version >/dev/null && break; \
      [ "$attempt" = 5 ] && exit 1; \
      echo "gradle distribution download failed (attempt $attempt), retrying" >&2; sleep 20; \
    done && \
    ./gradlew --no-daemon \
      -Dorg.gradle.internal.http.connectionTimeout=120000 \
      -Dorg.gradle.internal.http.socketTimeout=120000 \
      -Dorg.gradle.internal.repository.max.retries=6 \
      -Dorg.gradle.internal.repository.initial.backoff=2000 \
      :apps:api-app:installDist -x test

RUN install_dir=apps/api-app/build/install/api-app && \
    if [ ! -d "$install_dir/lib" ]; then \
      echo "ERROR: installDist output not found at $install_dir"; exit 1; \
    fi && \
    mkdir -p "/opt/bisq2/lib" && \
    cp "$install_dir"/lib/*.jar "/opt/bisq2/lib/" && \
    chmod -R o+rX /opt/bisq2/

FROM eclipse-temurin:21-jre-jammy AS java-runtime

FROM debian:bookworm-slim

ARG BISQ2_VERSION=2.1.15
ENV DEBIAN_FRONTEND=noninteractive
ENV BISQ2_VERSION=${BISQ2_VERSION}
ENV MALLOC_ARENA_MAX=4
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    ca-certificates \
    libcups2 \
    libfontconfig1 \
    libfreetype6 \
    libgcc-s1 \
    postgresql-client \
    procps \
    libstdc++6 \
    tor \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
COPY --from=bisq2-builder /opt/bisq2 /opt/bisq2
COPY bisqseed/bisq2-startup.sh /usr/local/bin/bisq2-startup.sh

RUN useradd -m -s /bin/sh appuser && \
    mkdir -p /home/appuser/.local/share/Bisq2 && \
    chown -R appuser:appuser /home/appuser/.local && \
    chmod 0755 /usr/local/bin/bisq2-startup.sh

# REST API port
EXPOSE 8090

# Allow more cold-start margin: run #227 was still unready after six minutes.
# This accommodates slow bootstrap; healthcheck output is needed to diagnose
# future failures rather than assuming every timeout is a false positive.
HEALTHCHECK --interval=30s --timeout=5s --start-period=480s --retries=3 \
    CMD /usr/bin/timeout 3s /bin/bash -lc '</dev/tcp/127.0.0.1/8090'

ENTRYPOINT ["/usr/local/bin/bisq2-startup.sh"]
