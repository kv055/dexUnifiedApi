+    // dexArbTrading: SEPA accounts cannot be created via createPaymentAccount(jsonString) on
+    // this build — the form parser mishandles SEPA's acceptedCountryCodes collection field and
+    // the daemon returns an opaque "unexpected error". We build the SepaAccount directly from
+    // discrete fields, mirroring createCryptoCurrencyPaymentAccount below.
+    PaymentAccount createSepaPaymentAccount(String accountName,
+                                            String holderName,
+                                            String iban,
+                                            String bic,
+                                            String countryCode) {
+        Country country = CountryUtil.findCountryByCode(countryCode)
+                .orElseThrow(() -> new IllegalArgumentException(
+                        format("'%s' is an invalid country code.", countryCode)));
+        SepaAccount sepaAccount = (SepaAccount) PaymentAccountFactory.getPaymentAccount(PaymentMethod.SEPA);
+        sepaAccount.init();
+        sepaAccount.setAccountName(accountName);
+        sepaAccount.setHolderName(holderName);
+        sepaAccount.setIban(iban);
+        sepaAccount.setBic(bic);
+        sepaAccount.setCountry(country);
+        // EUR single trade currency and the default all-SEPA acceptedCountryCodes are set by
+        // the SepaAccount constructor / createPayload, so no further wiring is required.
+        verifyPaymentAccountHasRequiredFields(sepaAccount);
+        user.addPaymentAccountIfNotExists(sepaAccount);
+        accountAgeWitnessService.publishMyAccountAgeWitness(sepaAccount.getPaymentAccountPayload());
+        log.info("Saved SEPA payment account with id {} and payment method {}.",
+                sepaAccount.getId(),
+                sepaAccount.getPaymentAccountPayload().getPaymentMethodId());
+        return sepaAccount;
+    }
+
+    // dexArbTrading: delete a saved payment account by id (stock gRPC has no delete).
+    void deletePaymentAccount(String paymentAccountId) {
+        PaymentAccount paymentAccount = user.getPaymentAccount(paymentAccountId);
+        if (paymentAccount == null)
+            throw new IllegalArgumentException(
+                    format("payment account with id '%s' not found", paymentAccountId));
+        user.removePaymentAccount(paymentAccount);
+        log.info("Deleted payment account with id {}.", paymentAccountId);
+    }
