+    uint64 funds_needed_for_trade_sats = 13;
+    uint64 missing_sats = 14;
+    bool is_btc_wallet_funded = 15;
+    string volume = 16;
+    int64 volume_as_long = 17;
+}
+
+// dexArbTrading: take an offer only when the live calculation matches confirmed limits.
+message GuardedTakeOfferRequest {
+    string offer_id = 1;
+    string payment_account_id = 2;
+    string taker_fee_currency_code = 3;
+    uint64 amount = 4;
+    uint64 max_wallet_debit_sats = 5;
+    int64 min_volume_as_long = 6;
+    int64 deadline_epoch_millis = 7;
+}
+
+message GetTakeCapabilitiesRequest {}
+message GetTakeCapabilitiesReply { uint32 guard_version = 1; }
+
 message ConfirmPaymentStartedRequest {
     string trade_id = 1;    // The unique identifier of the open trade.
 }
