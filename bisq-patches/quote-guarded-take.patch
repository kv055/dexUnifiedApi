+/*
+ * dexArbTrading: read-only Bisq v1 take-offer quote. Built from TakeOfferModel
+ * without reserving the offer, creating a trade, or broadcasting transactions.
+ */
+package bisq.core.api.model;
+
+import lombok.Getter;
+
+@Getter
+public final class TakeOfferQuote {
+    private final String offerId;
+    private final String paymentAccountId;
+    private final String paymentMethodId;
+    private final String currencyCode;
+    private final String price;
+    private final boolean isBuyOffer;
+    private final long tradeAmountSats;
+    private final long securityDepositSats;
+    private final long takerFeeSats;
+    private final boolean isCurrencyForTakerFeeBtc;
+    private final long miningFeeSats;
+    private final long totalToPaySats;
+    private final long fundsNeededForTradeSats;
+    private final long missingSats;
+    private final boolean isBtcWalletFunded;
+    private final String volume;
+    private final long volumeAsLong;
+
+    public TakeOfferQuote(String offerId,
+                          String paymentAccountId,
+                          String paymentMethodId,
+                          String currencyCode,
+                          String price,
+                          boolean isBuyOffer,
+                          long tradeAmountSats,
+                          long securityDepositSats,
+                          long takerFeeSats,
+                          boolean isCurrencyForTakerFeeBtc,
+                          long miningFeeSats,
+                          long totalToPaySats,
+                          long fundsNeededForTradeSats,
+                          long missingSats,
+                          boolean isBtcWalletFunded,
+                          String volume,
+                          long volumeAsLong) {
+        this.offerId = offerId;
+        this.paymentAccountId = paymentAccountId;
+        this.paymentMethodId = paymentMethodId;
+        this.currencyCode = currencyCode;
+        this.price = price;
+        this.isBuyOffer = isBuyOffer;
+        this.tradeAmountSats = tradeAmountSats;
+        this.securityDepositSats = securityDepositSats;
+        this.takerFeeSats = takerFeeSats;
+        this.isCurrencyForTakerFeeBtc = isCurrencyForTakerFeeBtc;
+        this.miningFeeSats = miningFeeSats;
+        this.totalToPaySats = totalToPaySats;
+        this.fundsNeededForTradeSats = fundsNeededForTradeSats;
+        this.missingSats = missingSats;
+        this.isBtcWalletFunded = isBtcWalletFunded;
+        this.volume = volume;
+        this.volumeAsLong = volumeAsLong;
+    }
+}
