# dexUnifiedApi — Environment Variables
# Copy this file to dexUnifiedApi/.env and fill in real secrets locally.

# --- Postgres ---
# Standalone URL (required by scripts/validate-env-contract.sh). Under
# docker-compose the server builds the URL from POSTGRES_HOST/PORT/DB/USER/
# PASSWORD, and DATABASE_URL below is overridden by the compose environment.
DATABASE_URL=postgres://dex_unified_api:dex_unified_api@localhost:5432/dexarb?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_unified_api
POSTGRES_PASSWORD=dex_unified_api
POSTGRES_ADMIN_USER=dex_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
POSTGRES_UNIFIED_API_PASSWORD=dex_unified_api
POSTGRES_MONITOR_PASSWORD=dex_monitor
POSTGRES_MM_CONTROLLER_PASSWORD=dex_mm_controller
POSTGRES_FIAT_CONTROLLER_PASSWORD=dex_fiat_controller
# Optional: password for the read-only dex_grafana_ro Postgres role that
# Grafana's postgres-dexarb datasource logs in with. When set, the role
# bootstrap creates/updates the role to match on every start; when empty the
# role is skipped. Must equal the value in the root .env bundle.
POSTGRES_GRAFANA_RO_PASSWORD=
BISQ_WALLET_PASSWORD=

# --- Server ---
LISTEN_ADDR=:5010
SNAPSHOT_INTERVAL_MIN=1
# Snapshot cycles to wait after last_seen before running closed-offer historical analysis.
CLOSED_OFFER_ANALYSIS_GRACE_CYCLES=3
# Days of order_lifecycle history to keep. 0 disables the sweep.
LIFECYCLE_RETENTION_DAYS=30
# Snapshot staleness grace before live offers count as stale (compose default).
LIVE_OFFER_STALE_GRACE=5m
# How often CEX account health/permission snapshots refresh (compose default).
ACCOUNT_HEALTH_INTERVAL=10m
# A successful CEX permission snapshot older than this is no longer trusted.
MM_CEX_CAPABILITY_MAX_AGE=30m
# Login session cookie Secure attribute (compose default true; false for HTTP dev).
SESSION_COOKIE_SECURE=true
# 32-byte base64 key for Postgres credential encryption. Injected from the ROOT
# .env under docker-compose; set here only for standalone runs.
APP_ENCRYPTION_KEY=
# Shared secret for fiat-arrival payment notifications (standalone runs only;
# injected from the ROOT .env under docker-compose).
PAYMENT_NOTIFICATIONS_SHARED_SECRET=
TOR_PROXY_ADDR=127.0.0.1:9050

# --- Internal API auth ---
# Shared secret protecting POST /internal/live_offers. The server (this binary)
# validates it; the snapshot tool sends it as the X-Internal-Secret header.
# Under docker-compose this is injected into BOTH the unified-api and
# unified-snapshot services from the ROOT .env (INTERNAL_API_SECRET), so you do
# NOT set it here for the dockerised stack — the compose `environment:` block
# would override this file anyway. Only uncomment/set it here when running the
# server or snapshot tool standalone (outside docker).
#
# The internal endpoints now fail CLOSED: when INTERNAL_API_SECRET is empty the
# server rejects the snapshot push (401) instead of accepting it unauthenticated.
# For local dev without a secret, set ALLOW_INSECURE_INTERNAL=true to opt back
# into the open behavior. In prod, set INTERNAL_API_SECRET in the ROOT .env.
# INTERNAL_API_SECRET=
# ALLOW_INSECURE_INTERNAL=

# --- Snapshot tool ---
BISQ_GRPC_HOST=localhost:9998
BISQ_API_PASSWORD=
BISQ2_REST_HOST=localhost:8090
BISQ2_API_PASSWORD=
PRICE_PROVIDER=bisq_tor
TOR_PROXY_URL=socks5h://127.0.0.1:9050
SERVER_INTERNAL_URL=http://localhost:5010

# --- RoboSats federation + bid-pricing reserve ---
# Official RoboSats federation registry used to discover current federated
# mainnet coordinators. Invalid/unavailable registries fall back to the bundled
# coordinator list. Injected from the ROOT .env under docker-compose.
ROBOSATS_FEDERATION_URL=https://raw.githubusercontent.com/RoboSats/robosats/main/frontend/static/federation.json
# Check at most this often; snapshots reuse the last valid cache between refreshes.
ROBOSATS_FEDERATION_REFRESH_INTERVAL=6h
# Conservative bid-pricing reserve (see ROOT .env for the formula).
COINBASE_WITHDRAW_RESERVE_FLOOR_SAT=10000
COINBASE_WITHDRAW_RESERVE_MULTIPLIER=2

# --- Noones offer ingestion (snapshot-only, like Peach: no taker connector) ---
# Direct-access OAuth credentials from the Noones app (P2P Market → profile →
# API keys; add the Noones API product to the key). Empty keeps the venue out
# of the snapshot fetcher list entirely. Injected from the ROOT .env under
# docker-compose.
NOONES_CLIENT_ID=
NOONES_CLIENT_SECRET=

# --- Postgres backup sidecar ---
# These values are consumed by the docker-compose postgres-backup service.
# Put real cloud credentials in the root .env used by docker compose.
PG_BACKUP_ENABLED=true
PG_BACKUP_INTERVAL=6h
PG_BACKUP_DIR=/backups
PG_BACKUP_FILE_PREFIX=dexarb
PG_BACKUP_RETENTION_DAYS=14
PG_BACKUP_UPLOAD=true
PG_BACKUP_UPLOAD_REQUIRED=true
PG_BACKUP_RCLONE_REMOTE=proton:postgres-backups/dexarb
PG_BACKUP_COMMAND_TIMEOUT=2h

# Proton Drive primary target. Proton Drive support in rclone is beta, so test
# unattended uploads before relying on it. The password must be rclone-obscured.
RCLONE_CONFIG_PROTON_TYPE=protondrive
RCLONE_CONFIG_PROTON_USERNAME=your@email.com
RCLONE_CONFIG_PROTON_PASSWORD=
# RCLONE_CONFIG_PROTON_2FA=

# Dropbox fallback target. Generate the token once with `rclone config` on a
# trusted machine, then place the token JSON here in your VPS/root .env.
# PG_BACKUP_RCLONE_REMOTE=dropbox:postgres-backups/dexarb
# RCLONE_CONFIG_DROPBOX_TYPE=dropbox
# RCLONE_CONFIG_DROPBOX_TOKEN=
