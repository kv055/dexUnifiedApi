# dexUnifiedApi — Environment Variables
# Copy this file to dexUnifiedApi/.env and fill in real secrets locally.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_unified_api
POSTGRES_PASSWORD=dex_unified_api
DATABASE_URL=postgres://dex_unified_api:dex_unified_api@localhost:5432/dexarb?sslmode=disable
POSTGRES_ADMIN_USER=dex_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
POSTGRES_UNIFIED_API_PASSWORD=dex_unified_api
POSTGRES_MONITOR_PASSWORD=dex_monitor
POSTGRES_MM_CONTROLLER_PASSWORD=dex_mm_controller
POSTGRES_FIAT_CONTROLLER_PASSWORD=dex_fiat_controller
BISQ_WALLET_PASSWORD=

# --- Server ---
LISTEN_ADDR=:5010
SNAPSHOT_INTERVAL_MIN=1
TOR_PROXY_ADDR=127.0.0.1:9050

# --- Snapshot tool ---
BISQ_GRPC_HOST=localhost:9998
BISQ_API_PASSWORD=
BISQ2_REST_HOST=localhost:8090
BISQ2_API_PASSWORD=
PRICE_PROVIDER=bisq_tor
TOR_PROXY_URL=socks5h://127.0.0.1:9050
SERVER_INTERNAL_URL=http://localhost:5010

# --- Postgres backup sidecar ---
# These values are consumed by the docker-compose postgres-backup service.
# Put real cloud credentials in the root .env used by docker compose.
PG_BACKUP_ENABLED=true
PG_BACKUP_INTERVAL=6h
PG_BACKUP_DIR=/backups
PG_BACKUP_FILE_PREFIX=dexarb
PG_BACKUP_RETENTION_DAYS=14
PG_BACKUP_UPLOAD=true
PG_BACKUP_UPLOAD_REQUIRED=true
PG_BACKUP_RCLONE_REMOTE=proton:postgres-backups/dexarb
PG_BACKUP_COMMAND_TIMEOUT=2h

# Proton Drive primary target. Proton Drive support in rclone is beta, so test
# unattended uploads before relying on it. The password must be rclone-obscured.
RCLONE_CONFIG_PROTON_TYPE=protondrive
RCLONE_CONFIG_PROTON_USERNAME=your@email.com
RCLONE_CONFIG_PROTON_PASSWORD=
# RCLONE_CONFIG_PROTON_2FA=

# Dropbox fallback target. Generate the token once with `rclone config` on a
# trusted machine, then place the token JSON here in your VPS/root .env.
# PG_BACKUP_RCLONE_REMOTE=dropbox:postgres-backups/dexarb
# RCLONE_CONFIG_DROPBOX_TYPE=dropbox
# RCLONE_CONFIG_DROPBOX_TOKEN=
