# dexUnifiedApi — Environment Variables
# Copy this file to dexUnifiedApi/.env and fill in real secrets locally.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_unified_api
POSTGRES_PASSWORD=dex_unified_api
DATABASE_URL=postgres://dex_unified_api:dex_unified_api@localhost:5432/dexarb?sslmode=disable
POSTGRES_ADMIN_USER=dex_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
POSTGRES_UNIFIED_API_PASSWORD=dex_unified_api
POSTGRES_MONITOR_PASSWORD=dex_monitor
POSTGRES_MM_CONTROLLER_PASSWORD=dex_mm_controller
POSTGRES_FIAT_CONTROLLER_PASSWORD=dex_fiat_controller

# --- Server ---
LISTEN_ADDR=:5010
SNAPSHOT_INTERVAL_MIN=1
TOR_PROXY_ADDR=127.0.0.1:9050

# --- Snapshot tool ---
BISQ_GRPC_HOST=localhost:9998
BISQ_API_PASSWORD=
PRICE_PROVIDER=bisq_tor
TOR_PROXY_URL=socks5h://127.0.0.1:9050
SERVER_INTERNAL_URL=http://localhost:5010
