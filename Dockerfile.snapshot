# Stage 1: Build Go binary
FROM golang:1.25-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY bisq_grpc/go/ ./bisq_grpc/go/
COPY cmd/snapshot/ ./cmd/snapshot/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o snapshot ./cmd/snapshot

# Stage 2: Minimal runtime
FROM alpine:3.21

RUN apk add --no-cache curl

WORKDIR /app

COPY --from=builder /build/snapshot ./

RUN adduser -D appuser && chown -R appuser:appuser /app

USER appuser

CMD ["sh", "-c", "while true; do /app/snapshot; sleep $((SNAPSHOT_INTERVAL_MIN * 60)); done"]
