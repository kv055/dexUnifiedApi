# Stage 1: Build Go binary
FROM golang:1.25-alpine AS builder

WORKDIR /build/dexUnifiedApi
COPY commons/ ../commons/
COPY dexUnifiedApi/go.mod dexUnifiedApi/go.sum ./
RUN go mod download
COPY dexUnifiedApi/bisq_grpc/go/ ./bisq_grpc/go/
COPY dexUnifiedApi/cmd/snapshot/ ./cmd/snapshot/
COPY dexUnifiedApi/internal/ ./internal/
COPY dexUnifiedApi/db/ ./db/
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o snapshot ./cmd/snapshot

# Stage 2: Minimal runtime
FROM alpine:3.21

RUN apk add --no-cache curl

WORKDIR /app

COPY --from=builder /build/dexUnifiedApi/snapshot ./

RUN adduser -D appuser && chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD sh -ec 'test -f /tmp/unified-snapshot-last-success && last_success="$(cat /tmp/unified-snapshot-last-success)" && now="$(date +%s)" && max_age="${SNAPSHOT_HEALTH_MAX_AGE_SEC:-180}" && [ $((now - last_success)) -le "$max_age" ]'

CMD ["sh", "-ec", "interval_minutes=\"${SNAPSHOT_INTERVAL_MIN:-1}\"; while true; do if /app/snapshot; then date +%s >/tmp/unified-snapshot-last-success; fi; sleep $((interval_minutes * 60)); done"]
