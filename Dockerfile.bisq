FROM debian:bookworm-slim AS bisq-downloader

ARG BISQ_VERSION=1.9.22
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/bisq && \
    wget -q "https://github.com/bisq-network/bisq/releases/download/v${BISQ_VERSION}/bisq-daemon-${BISQ_VERSION}.zip" -O /tmp/bisq-daemon.zip && \
    wget -q "https://github.com/bisq-network/bisq/releases/download/v${BISQ_VERSION}/bisq-cli-${BISQ_VERSION}.zip" -O /tmp/bisq-cli.zip && \
    unzip -q /tmp/bisq-daemon.zip -d /opt/bisq/ && \
    unzip -q /tmp/bisq-cli.zip -d /opt/bisq/ && \
    chmod -R o+rX /opt/bisq/ && \
    rm /tmp/bisq-daemon.zip /tmp/bisq-cli.zip

FROM eclipse-temurin:11-jre-jammy AS java-runtime

FROM debian:bookworm-slim

ARG BISQ_VERSION=1.9.22
ENV DEBIAN_FRONTEND=noninteractive
ENV BISQ_VERSION=${BISQ_VERSION}
ENV MALLOC_ARENA_MAX=4
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcups2 \
    libfontconfig1 \
    libfreetype6 \
    libgcc-s1 \
    procps \
    libstdc++6 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
COPY --from=bisq-downloader /opt/bisq /opt/bisq

RUN useradd -m -s /bin/sh appuser && \
    mkdir -p /home/appuser/.local/share/Bisq && \
    chown -R appuser:appuser /home/appuser/.local

EXPOSE 9998 9999

HEALTHCHECK --interval=30s --timeout=15s --start-period=300s --retries=3 \
    CMD java -jar /opt/bisq/bisq-cli-${BISQ_VERSION}/cli.jar --port 9998 --password= getversion > /dev/null 2>&1 || exit 1

WORKDIR /opt/bisq/bisq-daemon-${BISQ_VERSION}
ENTRYPOINT ["/bin/sh", "-c", "\
  APP_DIR=/home/appuser/.local/share/Bisq; \
  mkdir -p \"$APP_DIR\"; \
  chown -R appuser:appuser \"$APP_DIR\"; \
  DB=$APP_DIR/btc_mainnet/db; \
  if [ -d \"$DB\" ]; then \
    echo '[startup] Purging re-syncable P2P data...'; \
    rm -f \"$DB\"/TradeStatistics3Store_* \"$DB\"/AccountAgeWitnessStore_* \
          \"$DB/SignedWitnessStore\" \"$DB/AccountAgeWitnessStore\" \
          \"$DB/TradeStatistics3Store\" \"$DB/SequenceNumberMap\" \
          \"$DB/BlindVoteStore\" \
          \"$DB/ProposalStore\" \"$DB/TempProposalStore\" \
          \"$DB/BallotList\" \"$DB/BurningManAccountingStore_v3\" \
          \"$DB/RemovedPayloadsMap\" \"$DB/IgnoredMailboxMap\" \
          \"$DB/MailboxMessageList\"; \
    rm -rf $DB/backup/backups_TradeStatistics3Store* \
          $DB/backup/backups_AccountAgeWitnessStore* \
          $DB/backup/backups_SignedWitnessStore* \
          $DB/backup/backups_SequenceNumberMap* \
          $DB/backup/backups_BlindVoteStore* \
          $DB/backup/backups_ProposalStore* \
          $DB/backup/backups_BallotList* \
          $DB/backup/backups_MailboxMessageList* \
          $DB/backup/backups_IgnoredMailboxMap*; \
    echo \"[startup] Done. DB size: $(du -sh $DB | cut -f1)\"; \
  fi; \
  exec su -s /bin/sh appuser -c 'exec java \
    -Xmx2g \
    -XX:MaxMetaspaceSize=256m \
    -XX:ReservedCodeCacheSize=128m \
    -XX:MaxDirectMemorySize=128m \
    -XX:+UseG1GC \
    -jar daemon.jar \
    --apiPort=9998 \
    --apiPassword= \
    --appDataDir=/home/appuser/.local/share/Bisq \
    --nodePort=9999'"]
