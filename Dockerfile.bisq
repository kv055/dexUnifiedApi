# syntax=docker/dockerfile:1

FROM eclipse-temurin:21-jdk-jammy AS bisq-builder

ARG BISQ_VERSION=1.10.8
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "v${BISQ_VERSION}" --recurse-submodules --shallow-submodules \
    https://github.com/bisq-network/bisq.git /src/bisq

WORKDIR /src/bisq

# Surface each maker's account-signing sign-state + account-age-witness date on
# the gRPC getOffers response (stock OfferInfo strips it), for seller-rating
# ingestion. If a future BISQ_VERSION refactors the touched files, this apply
# fails and the build stops here — rebase bisq-patches/offerinfo-witness.patch.
COPY bisq-patches/offerinfo-witness.patch /tmp/offerinfo-witness.patch
RUN git apply --3way /tmp/offerinfo-witness.patch

# Add two PaymentAccounts gRPC methods the stock daemon lacks: CreateSepaPaymentAccount
# (builds a SEPA account server-side from discrete fields — the generic CreatePaymentAccount
# json path cannot round-trip SEPA on this build) and DeletePaymentAccount (surfaces the
# existing core User.removePaymentAccount). If a future BISQ_VERSION refactors the touched
# files, this apply fails and the build stops here — rebase
# bisq-patches/payment-accounts-sepa-delete.patch.
COPY bisq-patches/payment-accounts-sepa-delete.patch /tmp/payment-accounts-sepa-delete.patch
RUN git apply --3way /tmp/payment-accounts-sepa-delete.patch

# QuoteTakeOffer and version-2 GuardedTakeOffer use a single price/funding
# snapshot and enforce the deadline after the asynchronous availability check.
# Automated execution requires the versioned GetTakeCapabilities RPC;
# an older daemon must fail preflight rather than fall back to unrestricted take.
COPY bisq-patches/quote-guarded-take.patch /tmp/quote-guarded-take.patch
RUN git apply --3way /tmp/quote-guarded-take.patch

# Cache mount keeps gradle's dependency + wrapper caches across builds; without
# it every patch/version change re-downloads all deps and compiles cold (the
# dominant cost since the switch to building the daemon from source).
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew --no-daemon :daemon:installDist -x test

RUN if [ -d daemon/build/install/daemon/lib ]; then \
      src=daemon/build/install/daemon/lib; \
    elif [ -d daemon/build/app/lib ]; then \
      src=daemon/build/app/lib; \
    else \
      echo "ERROR: no daemon lib directory found"; exit 1; \
    fi && \
    mkdir -p "/opt/bisq/bisq-daemon/lib" && \
    cp "$src/daemon.jar" "/opt/bisq/bisq-daemon/daemon.jar" && \
    find "$src" -maxdepth 1 -name '*.jar' ! -name 'daemon.jar' \
       -exec cp {} "/opt/bisq/bisq-daemon/lib/" \; && \
    chmod -R o+rX /opt/bisq/

FROM eclipse-temurin:21-jre-jammy AS java-runtime

FROM eclipse-temurin:21-jdk-jammy AS bisq-seed-helper-build

ARG BISQ_VERSION=1.10.8

COPY bisqseed/ExtractBisqSeed.java /src/ExtractBisqSeed.java
COPY --from=bisq-builder /opt/bisq /opt/bisq

RUN mkdir -p /build && \
    javac \
      -cp "/opt/bisq/bisq-daemon/daemon.jar:/opt/bisq/bisq-daemon/lib/*" \
      -d /build \
      /src/ExtractBisqSeed.java

FROM debian:bookworm-slim

ARG BISQ_VERSION=1.10.8
ENV DEBIAN_FRONTEND=noninteractive
ENV BISQ_VERSION=${BISQ_VERSION}
ENV MALLOC_ARENA_MAX=4
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcups2 \
    libfontconfig1 \
    libfreetype6 \
    libgcc-s1 \
    libopenjfx-java \
    libopenjfx-jni \
    postgresql-client \
    procps \
    libstdc++6 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
COPY --from=bisq-builder /opt/bisq /opt/bisq
COPY --from=bisq-seed-helper-build /build /opt/bisq/bisq-seed-helper
COPY bisqseed/bisq-startup.sh /usr/local/bin/bisq-startup.sh

RUN useradd -m -s /bin/sh appuser && \
    mkdir -p /home/appuser/.local/share/Bisq && \
    chown -R appuser:appuser /home/appuser/.local && \
    chmod 0755 /usr/local/bin/bisq-startup.sh

EXPOSE 9998 9999

HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
    CMD /usr/bin/timeout 3s /bin/bash -lc '</dev/tcp/127.0.0.1/9998'

WORKDIR /opt/bisq/bisq-daemon
ENTRYPOINT ["/usr/local/bin/bisq-startup.sh"]
